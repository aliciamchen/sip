#!/usr/bin/env bash
# Deploy jsPsych experiments + the shared _lib/ to the athena server.
#
# Usage:
#   bin/deploy-experiment <slug>             # push _lib/ then the experiment
#   bin/deploy-experiment <slug> --dry-run   # show what would be transferred
#   bin/deploy-experiment --all              # push _lib/ + every experiment + preview
#   bin/deploy-experiment preview            # push _lib/ then the trial-preview page
#   bin/deploy-experiment --lib-only         # push only _lib/ (e.g. after editing it)
#   bin/deploy-experiment --list             # list active experiment slugs
#   bin/deploy-experiment --help
#
# Server destination is set in RSYNC_DEST below. Override per-invocation with
# `RSYNC_DEST=... bin/deploy-experiment <slug>` if needed.
#
# After deploy, the experiment is reachable at:
#   https://web.mit.edu/aliciach/www/sip/experiments/<slug>/

set -euo pipefail

# -------- config --------
: "${RSYNC_DEST:=aliciach@athena.dialup.mit.edu:~/www/sip/experiments}"

# Active experiments — keep in sync with the Makefile's EXPERIMENTS_INVERSE.
# Slugs not in this list are rejected to avoid accidentally deploying legacy
# experiments.
ACTIVE_EXPERIMENTS=(
  food_inv_desire
  food_inv_joint_de
  food_inv_intimacy
  food_inv_joint_ie
)

# Files/dirs not needed for runtime on the public server.
EXCLUDES=(
  --exclude='python/'
  --exclude='README.md'
  --exclude='.DS_Store'
  --exclude='*.bak'
)
# ------------------------

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

usage() {
  sed -n '2,15p' "$0" | sed 's/^# \?//'
  exit "${1:-0}"
}

list_experiments() {
  printf '%s\n' "${ACTIVE_EXPERIMENTS[@]}"
}

is_active() {
  local needle="$1"
  local candidate
  for candidate in "${ACTIVE_EXPERIMENTS[@]}"; do
    [[ "$candidate" == "$needle" ]] && return 0
  done
  return 1
}

slug=""
lib_only=false
deploy_all=false
dry_run=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)   usage 0 ;;
    --list)      list_experiments; exit 0 ;;
    --lib-only)  lib_only=true; shift ;;
    --all)       deploy_all=true; shift ;;
    --dry-run)   dry_run=true; shift ;;
    -*)          echo "unknown flag: $1" >&2; usage 1 ;;
    *)
      if [[ -n "$slug" ]]; then
        echo "multiple slugs given: '$slug' and '$1'" >&2
        usage 1
      fi
      slug="$1"; shift
      ;;
  esac
done

rsync_flags=(-av --delete "${EXCLUDES[@]}")
$dry_run && rsync_flags+=(--dry-run)

# Multiplex SSH across the (potentially two) rsync invocations so the password
# is entered once. The master connection is opened on the first rsync and
# torn down when the script exits.
ssh_ctl="${TMPDIR:-/tmp}/ssh-deploy-experiment-$$.sock"
export RSYNC_RSH="ssh -o ControlMaster=auto -o ControlPath=$ssh_ctl -o ControlPersist=60s"
cleanup_ssh() {
  local host="${RSYNC_DEST%%:*}"
  ssh -O exit -o "ControlPath=$ssh_ctl" "$host" 2>/dev/null || true
}
trap cleanup_ssh EXIT

push_lib() {
  echo "→ experiments/_lib/  ->  $RSYNC_DEST/_lib/"
  rsync "${rsync_flags[@]}" experiments/_lib/ "$RSYNC_DEST/_lib/"
}

push_experiment() {
  local s="$1"
  echo "→ experiments/$s/  ->  $RSYNC_DEST/$s/"
  rsync "${rsync_flags[@]}" "experiments/$s/" "$RSYNC_DEST/$s/"
}

if $lib_only; then
  push_lib
  exit 0
fi

# Push everything in one SSH session: _lib/ once, then every active experiment,
# then the preview page. The shared SSH master (above) means the password is
# entered a single time for the whole sweep.
if $deploy_all; then
  push_lib
  for s in "${ACTIVE_EXPERIMENTS[@]}"; do
    push_experiment "$s"
  done
  push_experiment preview
  echo
  echo "done. deployed _lib/, all active experiments, and the preview page:"
  for s in "${ACTIVE_EXPERIMENTS[@]}"; do
    echo "  https://web.mit.edu/aliciach/www/sip/experiments/$s/"
  done
  echo "  https://web.mit.edu/aliciach/www/sip/experiments/preview/"
  exit 0
fi

if [[ -z "$slug" ]]; then
  echo "no experiment slug provided" >&2
  usage 1
fi

# The trial-preview page (experiments/preview/) is not an experiment slug. It
# imports each study's trials.js + _lib/ and fetches one study's stimuli.json,
# so it relies on the four experiments already being deployed alongside it.
if [[ "$slug" == "preview" ]]; then
  push_lib
  push_experiment preview
  echo
  echo "done. URL: https://web.mit.edu/aliciach/www/sip/experiments/preview/"
  exit 0
fi

if ! is_active "$slug"; then
  echo "not an active experiment: $slug" >&2
  echo "active experiments:" >&2
  list_experiments | sed 's/^/  /' >&2
  exit 1
fi

push_lib
push_experiment "$slug"

echo
echo "done. URL: https://web.mit.edu/aliciach/www/sip/experiments/$slug/"
