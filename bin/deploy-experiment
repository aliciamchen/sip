#!/usr/bin/env bash
# Deploy jsPsych experiments + the shared _lib/ to the athena server.
#
# Usage:
#   bin/deploy-experiment <slug>             # push _lib/ then the experiment
#   bin/deploy-experiment <slug> --dry-run   # show what would be transferred
#   bin/deploy-experiment --all              # push _lib/ + every experiment + preview
#   bin/deploy-experiment preview            # push _lib/ then the trial-preview page
#   bin/deploy-experiment --lib-only         # push only _lib/ (e.g. after editing it)
#   bin/deploy-experiment --list             # list active experiment slugs
#   bin/deploy-experiment --check-artifacts  # only verify generated assets are fresh
#   bin/deploy-experiment --help
#
# Every deploy first regenerates the generated assets (scenarios.csv, each
# json/stimuli.json + full_counterbalancing.json, and the entry files) from
# their source via `make experiments` and refuses to ship if that changed
# anything — i.e. an asset was out of sync with its source. This is the guard
# against deploying stale stimuli; run it on its own with --check-artifacts.
#
# Server destination is set in RSYNC_DEST below. Override per-invocation with
# `RSYNC_DEST=... bin/deploy-experiment <slug>` if needed.
#
# After deploy, the experiment is reachable at:
#   https://web.mit.edu/aliciach/www/sip/experiments/<slug>/

set -euo pipefail

# -------- config --------
: "${RSYNC_DEST:=aliciach@athena.dialup.mit.edu:~/www/sip/experiments}"

# Active experiments — keep in sync with the Makefile's experiment roster
# (EXPERIMENTS_INVERSE + EXPERIMENTS_NONFOOD). Slugs not in this list are
# rejected to avoid accidentally deploying legacy experiments.
ACTIVE_EXPERIMENTS=(
  food_inv_desire
  food_inv_joint_de
  food_inv_intimacy
  food_inv_joint_ie
  nonfood_inv_joint_de
  nonfood_inv_joint_ie
)

# Files/dirs not needed for runtime on the public server.
EXCLUDES=(
  --exclude='python/'
  --exclude='README.md'
  --exclude='.DS_Store'
  --exclude='*.bak'
)
# ------------------------

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

usage() {
  sed -n '2,24p' "$0" | sed 's/^# \?//'
  exit "${1:-0}"
}

# Refuse to ship stale generated assets. scenarios.py + the experiments/build/
# generators are the source of truth for scenarios.csv and every per-experiment
# json/stimuli.json, json/full_counterbalancing.json, index.html, and
# experiment.js; a deploy only rsyncs what is on disk, so a forgotten
# regeneration would push stale stimuli to participants. Regenerate from source
# (make experiments) and compare each asset's content before vs. after: if
# anything changed, the on-disk asset was out of sync, so abort and tell the
# user to review and commit. Comparing before/after — rather than to HEAD —
# means merely-uncommitted-but-current assets do not trip the guard.
ensure_artifacts_current() {
  echo "→ verifying generated experiment assets are in sync with their source…"
  # An array, not an unquoted word-split string, so a path with whitespace or
  # glob characters can never silently split or expand.
  local -a artifacts=()
  local f
  while IFS= read -r f; do artifacts+=("$f"); done < <(git ls-files -- \
    'experiments/scenarios.csv' \
    'experiments/scenarios_nonfood.csv' \
    'experiments/*/json/stimuli.json' \
    'experiments/*/json/full_counterbalancing.json' \
    'experiments/*/index.html' \
    'experiments/*/experiment.js')
  # Fail loudly if the globs matched nothing: that means the asset layout
  # changed under the guard (and an empty array would trip `set -u` on old
  # bash anyway).
  if [[ ${#artifacts[@]} -eq 0 ]]; then
    echo "ERROR: no tracked generated assets matched — check the git ls-files globs above." >&2
    exit 1
  fi
  local before after
  before=$(git hash-object -- "${artifacts[@]}")
  make experiments >/dev/null
  after=$(git hash-object -- "${artifacts[@]}")
  if [[ "$before" != "$after" ]]; then
    echo >&2
    echo "ERROR: generated experiment assets were OUT OF SYNC with their source." >&2
    echo "Regenerating from source (make experiments) changed:" >&2
    paste <(printf '%s\n' "${artifacts[@]}") <(echo "$before") <(echo "$after") \
      | awk -F '\t' '$2 != $3 { print "  " $1 }' >&2
    echo >&2
    echo "The files are now regenerated. Review the diff, commit, then re-run the deploy." >&2
    exit 1
  fi
  echo "  assets are up to date."
}

list_experiments() {
  printf '%s\n' "${ACTIVE_EXPERIMENTS[@]}"
}

is_active() {
  local needle="$1"
  local candidate
  for candidate in "${ACTIVE_EXPERIMENTS[@]}"; do
    [[ "$candidate" == "$needle" ]] && return 0
  done
  return 1
}

slug=""
lib_only=false
deploy_all=false
dry_run=false
check_only=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)        usage 0 ;;
    --list)           list_experiments; exit 0 ;;
    --lib-only)       lib_only=true; shift ;;
    --all)            deploy_all=true; shift ;;
    --dry-run)        dry_run=true; shift ;;
    --check-artifacts) check_only=true; shift ;;
    -*)               echo "unknown flag: $1" >&2; usage 1 ;;
    *)
      if [[ -n "$slug" ]]; then
        echo "multiple slugs given: '$slug' and '$1'" >&2
        usage 1
      fi
      slug="$1"; shift
      ;;
  esac
done

# Verify (and, on drift, regenerate) the generated assets before doing anything
# over the network. --check-artifacts stops here; --lib-only ships no generated
# assets, so it is exempt.
if $check_only; then
  ensure_artifacts_current
  exit 0
fi
$lib_only || ensure_artifacts_current

# --checksum: the artifact guard regenerates all generated files before every
# push, freshening their mtimes, so rsync's default size+mtime quick-check
# would re-send every experiment's artifacts; comparing content hashes keeps
# the transfer list limited to files that actually changed.
rsync_flags=(-avc --delete "${EXCLUDES[@]}")
$dry_run && rsync_flags+=(--dry-run)

# Multiplex SSH across the (potentially two) rsync invocations so the password
# is entered once. The master connection is opened on the first rsync and
# torn down when the script exits.
ssh_ctl="${TMPDIR:-/tmp}/ssh-deploy-experiment-$$.sock"
export RSYNC_RSH="ssh -o ControlMaster=auto -o ControlPath=$ssh_ctl -o ControlPersist=60s"
cleanup_ssh() {
  local host="${RSYNC_DEST%%:*}"
  ssh -O exit -o "ControlPath=$ssh_ctl" "$host" 2>/dev/null || true
}
trap cleanup_ssh EXIT

push_lib() {
  echo "→ experiments/_lib/  ->  $RSYNC_DEST/_lib/"
  rsync "${rsync_flags[@]}" experiments/_lib/ "$RSYNC_DEST/_lib/"
}

push_experiment() {
  local s="$1"
  echo "→ experiments/$s/  ->  $RSYNC_DEST/$s/"
  rsync "${rsync_flags[@]}" "experiments/$s/" "$RSYNC_DEST/$s/"
}

if $lib_only; then
  push_lib
  exit 0
fi

# Push everything in one SSH session: _lib/ once, then every active experiment,
# then the preview page. The shared SSH master (above) means the password is
# entered a single time for the whole sweep.
if $deploy_all; then
  push_lib
  for s in "${ACTIVE_EXPERIMENTS[@]}"; do
    push_experiment "$s"
  done
  push_experiment preview
  echo
  echo "done. deployed _lib/, all active experiments, and the preview page:"
  for s in "${ACTIVE_EXPERIMENTS[@]}"; do
    echo "  https://web.mit.edu/aliciach/www/sip/experiments/$s/"
  done
  echo "  https://web.mit.edu/aliciach/www/sip/experiments/preview/"
  exit 0
fi

if [[ -z "$slug" ]]; then
  echo "no experiment slug provided" >&2
  usage 1
fi

# The trial-preview page (experiments/preview/) is not an experiment slug. It
# imports each study's trials.js + _lib/ and fetches one study's stimuli.json,
# so it relies on the four experiments already being deployed alongside it.
if [[ "$slug" == "preview" ]]; then
  push_lib
  push_experiment preview
  echo
  echo "done. URL: https://web.mit.edu/aliciach/www/sip/experiments/preview/"
  exit 0
fi

if ! is_active "$slug"; then
  echo "not an active experiment: $slug" >&2
  echo "active experiments:" >&2
  list_experiments | sed 's/^/  /' >&2
  exit 1
fi

push_lib
push_experiment "$slug"

echo
echo "done. URL: https://web.mit.edu/aliciach/www/sip/experiments/$slug/"
