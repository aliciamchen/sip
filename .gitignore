# Local-only archives and exploration: superseded-experiment data, the
# non-fitted model-behavior visualizations, LM-baseline evals, figure sources.
data/legacy/
model/model_viz_nonfit/
LM_evals/
writing/old_stuff

# Transient CV fold checkpoint (resume file; deleted when the final outputs land).
model/outputs/*/cv_checkpoint.jsonl
model/outputs/*/alt/*/cv_checkpoint.jsonl

# Exploratory transfer/pooled CV runs (`make transfer` / `make pooled`); only
# their small summaries under model/outputs/{transfer,pooled}/ are committed.
model/outputs/*/alt/transfer-*/
model/outputs/*/alt/pooled-*/

# Diagnostic-arm LM elicitations (--arm smokes); throwaway by construction —
# the reported fits read only the unsuffixed committed tables, and no
# canonical filename contains "_diag".
model/outputs/lm/*/*_diag*

# Cross-process elicitation lock sidecars (deleted on normal exit; a stale one
# from a killed run is reclaimed automatically).
model/outputs/lm/*/*.lock

.positai
.claude/worktrees/

# PNG previews beside the generated figure PDFs; regenerate in seconds.
figures/**/*.png

# Generated but not cited by the paper (the levels figure is; this one isn't).
figures/si/si_prior_posterior_distributions.pdf
